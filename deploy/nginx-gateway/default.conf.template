# 平台网关模式的 Nginx 配置（compose.gateway.yml 挂到 /etc/nginx/templates；nginx:1.27-alpine 启动时用环境变量 DOMAIN 替换后写成 /etc/nginx/conf.d/default.conf）。
# TLS 在平台网关做，这里只听一个普通 HTTP 端口（容器里 8080，映射到机器上的 TOPUP_HTTP_PORT），转给 web。
#
# 真实 IP：Nginx 看到的 $remote_addr 是平台网关的地址，不是访客的。网关用哪个请求头带访客 IP（X-Forwarded-For 还是 X-Real-IP）、
# 从哪些地址连进来，要在机器上实测后才能定，所以默认不信任任何请求头（访客自己带的也不算）：
#   - 默认（TOPUP_REAL_IP_HEADER=off）：所有访客在应用看来都是网关的地址——按 IP 限流大家共用一个额度，商户的 IP 白名单在生产上不能用（未验证）
#   - 实测后：sudo topup set TOPUP_REAL_IP_FROM <网关地址段> 和 sudo topup set TOPUP_REAL_IP_HEADER X-Forwarded-For（或 X-Real-IP），
#     topup.sh 生成 realip.conf（set_real_ip_from + real_ip_header + real_ip_recursive），只认从网关地址段来的这个请求头
# 不管哪种，转给 web 的 X-Real-IP、X-Forwarded-For 都用（换算后的）$remote_addr 覆盖，不是追加；web 设了 TRUST_PROXY=1。
# 访问日志里记网关的地址和两个请求头（实测用：docker logs topup-nginx-1 看网关带的是哪一个）。

server_tokens off;
# 开户文件单个最大 10 MB（server/kyb/schema.js），留一点余量
client_max_body_size 12m;

include /etc/nginx/topup/realip.conf;

log_format topup_gw '$realip_remote_addr client=$remote_addr xff="$http_x_forwarded_for" xri="$http_x_real_ip" '
                    '[$time_local] "$request" $status $body_bytes_sent "$http_user_agent"';

# 第一道限流（只防明显的洪水；精细的按 IP 限流在 web 进程里）：每个 IP 每秒 20 个，瞬间最多多出 200 个；同时 100 个连接
# 注意：真实 IP 没打开时所有访客共用网关地址这一个额度
limit_req_zone $binary_remote_addr zone=topup_req:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=topup_conn:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 8080 default_server;
    server_name _;
    access_log /var/log/nginx/access.log topup_gw;

    # Strict-Transport-Security 由 web 自己加（server/http-rules.json），这里不重复
    # 只在本地端到端测试里存在的地址，服务器上一律 404（web 进程在非本地模式下本来也不提供）
    location ^~ /__fake/ {
        return 404;
    }

    # 更新版本时 web 容器会重建、地址会变：用 Docker 内置 DNS 每 10 秒重新解析，不缓存旧地址
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $topup_web http://web:8080;

    location / {
        limit_req zone=topup_req burst=200 nodelay;
        limit_conn topup_conn 100;
        proxy_pass $topup_web;
        proxy_http_version 1.1;
        # 主机名一律用部署时定的 DOMAIN（= PUBLIC_URL 的主机名）：网关转过来时 Host 是什么都不影响应用的同源检查
        proxy_set_header Host ${DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${DOMAIN};
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
