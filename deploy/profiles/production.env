# 生产（8 GB 内存、16 GB 磁盘的小虚拟机）的容器内存上限和参数。由 deploy/kit/topup.sh 作为 docker compose 的变量文件传入（排在 deploy.env 后面，以这里为准）。
# 合计 2,368 MB，加 100 MB 余量：启动前要求可用内存 ≥ 2,468 MB。依据见 deploy/README.md 第 3 节（生产一栏）。
TOPUP_MEM_POSTGRES=1024m
TOPUP_MEM_REDIS=256m
TOPUP_MEM_WEB=512m
TOPUP_MEM_WORKER=512m
TOPUP_MEM_NGINX=64m
TOPUP_NODE_HEAP_MB=384
TOPUP_PG_SHARED_BUFFERS=256MB
TOPUP_PG_EFFECTIVE_CACHE=1GB
TOPUP_PG_MAX_CONNECTIONS=40
TOPUP_REDIS_MAXMEMORY=192mb
# 磁盘只有 16 GB：本机除了正在用的和上一个只再多留 1 个旧版本的镜像（合计 3 个），本机加密备份合计最多 1 GB
TOPUP_KEEP_IMAGES=1
TOPUP_BACKUP_MAX_MB=1024
