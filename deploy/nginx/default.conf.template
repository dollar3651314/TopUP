# TopUP 的 Nginx 配置（nginx:1.27-alpine 启动时用环境变量 DOMAIN、CERT_NAME 替换后写成 /etc/nginx/conf.d/default.conf）。
# 页面和接口都由 web 进程提供，这里只做 HTTPS、跳转、真实 IP 和第一道限流。
# 真实 IP：X-Real-IP、X-Forwarded-For 都用 $remote_addr 覆盖（不是追加），访客自己带的请求头不起作用；
# web 进程设了 TRUST_PROXY=1，付款页、开放 API 的按 IP 限流用的就是这里写入的 X-Real-IP。
# 域名在 DNS 里必须是"仅解析"（不经过 CDN 代理），否则 $remote_addr 是 CDN 的地址，所有访客会共用一个限流额度。

server_tokens off;
# 开户文件单个最大 10 MB（server/kyb/schema.js），留一点余量
client_max_body_size 12m;

# 第一道限流（只防明显的洪水；精细的按 IP 限流在 web 进程里）：每个 IP 每秒 20 个，瞬间最多多出 200 个；同时 100 个连接
limit_req_zone $binary_remote_addr zone=topup_req:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=topup_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# 只监听 IPv4：Docker 默认的容器网络没有 IPv6（容器里监听 [::] 会启动失败）；服务器的 IPv6 由 Docker 端口映射转进来
# HTTP：证书验证文件；其余跳到 HTTPS
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# 用 IP 或别的域名访问 443：直接断开握手（不暴露证书里的域名）
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:topup_ssl:5m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # 只在本地端到端测试里存在的地址，服务器上一律 404（web 进程在非本地模式下本来也不提供）
    location ^~ /__fake/ {
        return 404;
    }

    # 更新版本时 web 容器会重建、地址会变：用 Docker 内置 DNS 每 10 秒重新解析，不缓存旧地址
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $topup_web http://web:8080;

    location / {
        limit_req zone=topup_req burst=200 nodelay;
        limit_conn topup_conn 100;
        proxy_pass $topup_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
