# TopUP 的环境变量清单（只有变量名和说明，不放任何真实值）。
# 服务器上把它复制成 .env（权限 600），由部署的人填写；.env 不进仓库、不打进镜像。

# 环境：production / staging / local
APP_ENV=
# 站点的对外地址，例如 https://pay.example.com（邮件里的链接、付款链接）
PUBLIC_URL=
# web 进程监听的地址和端口（Docker 里用 0.0.0.0）
HOST=
PORT=
# 在 Nginx 后面运行时填 1：访客 IP 取 Nginx 写入的 X-Real-IP
TRUST_PROXY=
# 当前部署的提交号（构建时写入，健康检查返回前 7 位）
GIT_COMMIT=

# 主密钥（至少 32 位）：加密开户资料、API Secret 等，换了以后旧数据解不开
APP_SECRET=
# 运营后台首次初始化的口令（初始化完成后可以删掉）
ADMIN_SETUP_TOKEN=

# Postgres（收付款）
DATABASE_URL=
# Redis（管理员会话、限流、开户资料）
REDIS_URL=
# 开户文件的保存目录（加密保存；备份由部署脚本负责）
BLOB_DIR=

# 邮件：二选一，填了 RESEND_API_KEY 就用 Resend，否则用 SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 管理员通知邮件的收件人
MAIL_TO=

# TRON（TronGrid）
TRON_NETWORK=
TRONGRID_API_KEY=
USDT_CONTRACT=

# worker 进程：扫链间隔（毫秒，默认 15000）、每日任务的时间（UTC，默认 19:15）
TICK_INTERVAL_MS=
DAILY_AT_UTC=
