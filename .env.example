# TopUP 的环境变量清单（只有变量名和说明，不放任何真实值）。
# 服务器上把它复制成 .env（权限 600），由部署的人填写；.env 不进仓库、不打进镜像。

# 环境：production / staging / local
APP_ENV=
# 站点的对外地址，例如 https://pay.example.com（邮件里的链接、付款链接）
PUBLIC_URL=
# web 进程监听的地址和端口（Docker 里用 0.0.0.0）
HOST=
PORT=
# 在 Nginx 后面运行时填 1：访客 IP 取 Nginx 写入的 X-Real-IP
TRUST_PROXY=
# 当前部署的提交号（构建时写入，健康检查返回前 7 位）
GIT_COMMIT=

# 主密钥（至少 32 位）：加密开户资料、API Secret 等，换了以后旧数据解不开
APP_SECRET=
# 运营后台首次初始化的口令（初始化完成后可以删掉）
ADMIN_SETUP_TOKEN=

# Postgres（收付款）
DATABASE_URL=
# Redis（管理员会话、限流、开户资料）
REDIS_URL=
# 开户文件的保存目录（加密保存；备份由部署脚本负责）
BLOB_DIR=

# 邮件：二选一，填了 RESEND_API_KEY 就用 Resend，否则用 SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 管理员通知邮件的收件人
MAIL_TO=

# TRON（TronGrid）
TRON_NETWORK=
TRONGRID_API_KEY=
USDT_CONTRACT=

# worker 进程：扫链间隔（毫秒，默认 15000）、每日任务的时间（UTC，默认 19:15）
TICK_INTERVAL_MS=
DAILY_AT_UTC=

# ETH、BSC 合约钱包（合约地址是公开信息，在 config/wallets.json，改要走 PR）
# 节点地址（可能带 API Key）；没填的链不开通
ETH_RPC_URL=
BSC_RPC_URL=
# 入账要的确认数（默认 12、15）
ETH_CONFIRMATIONS=
BSC_CONFIRMATIONS=
# 归集发起账户的私钥：它只能调用批量合约，钱只能进冷钱包；没有时只能分配地址和扫链，不能执行归集
SWEEP_OPERATOR_KEY=

# TRON 合约钱包（第 2 批；合约地址在 config/wallets.json 的 tron 一节，改要走 PR）
# 节点地址（可选；不填按 TRON_NETWORK 用 TronGrid，带上面的 TRONGRID_API_KEY）
TRON_NODE_URL=
# 入账要的确认数（默认 19）
TRON_CONFIRMATIONS=
# TRON 归集发起账户的私钥：它只能调用 TRON 批量合约，钱只能进冷钱包；和 ETH、BSC 的不是同一把，测试环境和生产各一把
SWEEP_OPERATOR_KEY_TRON=
# 租能量平台 TronSave 的 API Key（可选；不填就烧 TRX 付手续费）。平台预存余额建议不超过 1,000 TRX
TRONSAVE_API_KEY=
# 租能量的单价上限（sun / 能量，默认 90，比烧 TRX 便宜才租）和单次最多租多少能量（默认 6500000，约一批 20 个地址全部首次部署）
TRONSAVE_MAX_PRICE_SUN=
TRON_RENT_MAX_ENERGY=
